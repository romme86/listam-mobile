# Bare backend bundles are BUILD ARTIFACTS produced by `npm run bundle:backend:*`
# (run for you by `npm run ios` / `npm run android`). They were committed until
# 2026-07-27; two ~3.2 MB base64 blobs regenerated on every backend change had
# grown this repo's .git to 167 MB. app/bundles.d.ts declares their module shape
# so typecheck and CI work on a clean checkout without generating them.
*.bundle
*.bundle.js
app/app.ios.bundle
app/app.ios.bundle.mjs
app/assets/backend.android.bundle
app/assets/backend.android.bundle.mjs
web-build/

# OS / editor / tooling junk
.DS_Store
__pycache__/
*.pyc

# The npm lockfile IS committed (Phase 0): reproducible installs via `npm ci`.
# It is intentionally NOT ignored.

# Runtime logs (may contain key material printed via console.error)
*.log
logs_*
app/logs_*

# App-generated plaintext secret/key artifacts (encryption key, base key,
# writer key, invites) — written by the Bare backend at runtime
*.env
.env
lista-autobase-key.txt
lista-encryption-key.txt
lista-local-writer-key.txt
lista-invite.json
autobase-key.txt
encryption-key.txt
local-writer-key.txt
invite.json

# Design mockups are tracked in listam-desktop/design-guide/ (single copy);
# keeping a duplicate here would add ~4 MB of PNGs to this repo.
docs/feature_activation_mockups/
